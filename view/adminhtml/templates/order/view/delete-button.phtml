</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var trigger = document.getElementById('panth-oc-delete-trigger');
    var modal = document.getElementById('panth-oc-modal');
    var cancelBtn = document.getElementById('panth-oc-cancel');
    var confirmBtn = document.getElementById('panth-oc-confirm');
    var typeInput = document.getElementById('panth-oc-type-input');
    var expectedId = '<?= $block->escapeJs($block->getOrderIncrementId()) ?>';
    var requireType = <?= $requireTypeId ? 'true' : 'false' ?>;
    var requireConfirm = <?= $requireConfirm ? 'true' : 'false' ?>;
    var placeTrigger = function () {
        var main = document.querySelector('.page-main-actions');
        if (!trigger || !main) {
            return;
        }
        var bar = main.querySelector('.page-actions-buttons') || main.querySelector('.page-actions');
        if (!bar) {
            return;
        }
        main.classList.add('panth-oc-wrap');
        if (trigger.parentElement === bar) {
            return;
        }
        var back = bar.querySelector('#back');
        if (back && back.parentElement === bar) {
            bar.insertBefore(trigger, back.nextSibling);
        } else {
            bar.insertBefore(trigger, bar.firstChild);
        }
    };
    placeTrigger();
    window.addEventListener('load', placeTrigger);

    if (!requireType) {
        confirmBtn.disabled = false;
    }

    var isOpen = function () {
        return modal.classList.contains('active');
    };

    var openModal = function () {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        if (typeInput) {
            typeInput.focus();
        } else {
            cancelBtn.focus();
        }
    };

    var closeModal = function () {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        if (typeInput) {
            typeInput.value = '';
            typeInput.classList.remove('valid');
            confirmBtn.disabled = true;
        }
        trigger.focus();
    };

    trigger.addEventListener('click', function () {
        if (!requireConfirm && !requireType) {
            if (confirm('Are you sure you want to delete order #' + expectedId + '? This cannot be undone.')) {
                document.getElementById('panth-oc-form').submit();
            }
            return;
        }
        openModal();
    });

    cancelBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function (e) {
        if (e.target === modal) {
            closeModal();
        }
    });

    if (typeInput) {
        typeInput.addEventListener('input', function () {
            var match = this.value.trim() === expectedId;
            confirmBtn.disabled = !match;
            this.classList.toggle('valid', match);
        });
    }

    document.addEventListener('keydown', function (e) {
        if (!isOpen()) {
            return;
        }
        if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
            return;
        }
        if (e.key === 'Tab') {
            var focusable = Array.prototype.filter.call(
                modal.querySelectorAll('input:not([type=hidden]), button'),
                function (el) {
                    return !el.disabled;
                }
            );
            if (!focusable.length) {
                return;
            }
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (e.shiftKey && (document.activeElement === first || !modal.contains(document.activeElement))) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && (document.activeElement === last || !modal.contains(document.activeElement))) {
                e.preventDefault();
                first.focus();
            }
        }
    });
});
</script>
